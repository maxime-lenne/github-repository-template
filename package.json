{
  "name": "github-repository-template",
  "version": "1.1.0",
  "description": "",
  "type": "module",
  "main": "index.js",
  "author": "Maxime Lenne",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": "^22.14.0 || >=24.10.0"
  },
  "packageManager": "bun@1.4.2",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "bun run lint:md && bun run lint:yaml && bun run lint:commit",
    "lint:md": "markdownlint '**/*.md' --ignore node_modules --ignore dist",
    "lint:md:fix": "markdownlint '**/*.md' --ignore node_modules --ignore dist --fix",
    "lint:yaml": "yamllint .",
    "lint:commit": "commitlint --last -V",
    "prepare": "husky",
    "commit": "gitmoji -c",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run",
    "setup:github": "bun scripts/setup-github.js"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "gitmoji-cli": "^9.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "markdownlint-cli": "^0.49.1",
    "semantic-release": "^25.0.9"
  },
  "lint-staged": {
    "*.md": "markdownlint --fix",
    "*.{yml,yaml}": "yamllint"
  }
}
